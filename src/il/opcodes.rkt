#lang racket/base
;; ECMA-335 Partition III CIL opcode table, as data.
;; Mirrors tests/fixtures/opcodes.tsv (System.Reflection.Emit), minus the
;; reserved prefix1-prefix7 and prefixref entries, plus `no.` (FE 19).
;; Stack behaviours use the Reflection.Emit StackBehaviour names.
;; Ordered by opcode value.

(provide (struct-out opcode)
         opcode-table
         opcode-size)

(struct opcode (name value operand flow pop push type) #:transparent)

;; Single-byte opcodes are values below #x100; the rest are FE-prefixed.
(define (opcode-size op)
  (if (< (opcode-value op) #x100) 1 2))

